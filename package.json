{
  "name": "cookie-and-tea-backend",
  "version": "1.0.0",
  "description": "creator support app like Buy Me a Coffee or Ko-fi.",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --legacy-watch src/servers/index.js",
    "start": "npm run db:migrate && node src/servers/index.js",
    "health": "node src/servers/health.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docker:dev": "bash src/scripts/bash/dev.sh",
    "docker:prod": "bash src/scripts/bash/prod.sh",
    "db:generate": "dotenv -e .env -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- node src/db/migrate.js",
    "db:migrate:test": "cross-env NODE_ENV=test node --env-file=.env.test src/db/migrate.js",
    "db:seed": "dotenv -e .env -- node src/db/seed.js",
    "db:seed:test": "cross-env NODE_ENV=test node --env-file=.env.test src/db/seed.js",
    "test": "cross-env NODE_ENV=test node --experimental-vm-modules --env-file=.env.test node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:clean": "bash src/scripts/bash/test.sh clean",
    "test:docker": "bash src/scripts/bash/test.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kybrakorkmaz/cookie-and-tea-backend.git"
  },
  "keywords": [],
  "author": "Kubra Korkmaz",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/kybrakorkmaz/cookie-and-tea-backend/issues"
  },
  "homepage": "https://github.com/kybrakorkmaz/cookie-and-tea-backend#readme",
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "nodemailer": "^8.0.10",
    "postgres": "^3.4.9",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@jest/globals": "^30.4.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.4.0",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.3"
  }
}
