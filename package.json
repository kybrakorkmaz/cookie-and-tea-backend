{
  "name": "cookie-and-tea-backend",
  "version": "1.0.0",
  "description": "creator support app like Buy Me a Coffee or Ko-fi.",
  "main": "index.js",
  "scripts": {
    "dev": "node --watch src/server/index.js",
    "start": "npm run db:migrate && node src/server/index.js",
    "health": "node src/server/health.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "dotenv -e .env -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- node src/db/migrate.js",
    "db:generate:test": "cross-env NODE_ENV=test node --env-file=.env.test node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate:test": "cross-env NODE_ENV=test node --env-file=.env.test src/db/migrate.js",
    "docker:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker-compose.dev.yml down",
    "docker:down:volumes": "docker compose -f docker-compose.dev.yml down -v",
    "docker:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "test": "cross-env NODE_ENV=test node --experimental-vm-modules --env-file=.env.test node_modules/.bin/jest --runInBand",
    "docker:db:migrate": "docker exec cat_dev sh -c \"npm run db:migrate\"",
    "docker:db:migrate:exec": "docker compose -f docker-compose.dev.yml exec api npm run db:migrate",
    "docker:db:migrate:test": "docker exec cat_dev sh -c \"npm run db:migrate:test\"",
    "docker:db:migrate:test:exec": "docker compose -f docker-compose.dev.yml exec api npm run db:migrate:test",
    "docker:test:up": "docker compose -p cookie-test -f docker-compose.test.yml up -d",
    "docker:test:down": "docker compose -p cookie-test -f docker-compose.test.yml down -v",
    "docker:test:migrate": "docker compose -p cookie-test -f docker-compose.test.yml exec api npm run db:migrate:test",
    "docker:test:run": "docker compose -p cookie-test -f docker-compose.test.yml exec api npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kybrakorkmaz/cookie-and-tea-backend.git"
  },
  "keywords": [],
  "author": "Kubra Korkmaz",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/kybrakorkmaz/cookie-and-tea-backend/issues"
  },
  "homepage": "https://github.com/kybrakorkmaz/cookie-and-tea-backend#readme",
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.4.0",
    "supertest": "^6.3.3"
  }
}
