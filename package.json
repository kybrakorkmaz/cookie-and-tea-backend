{
  "name": "cookie-and-tea-backend",
  "version": "1.0.0",
  "description": "creator support app like Buy Me a Coffee or Ko-fi.",
  "main": "index.js",
  "scripts": {
    "dev": "node --watch --watch-path=src src/servers/index.js",
    "start": "npm run db:migrate && node src/servers/index.js",
    "health": "node src/servers/health.js",

    "lint": "eslint .",
    "lint:fix": "eslint . --fix",

    "db:generate": "dotenv -e .env -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- node src/db/migrate.js",

    "db:generate:test": "cross-env NODE_ENV=test node --env-file=.env.test node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate:test": "cross-env NODE_ENV=test node --env-file=.env.test src/db/migrate.js",

    "test": "cross-env NODE_ENV=test node --experimental-vm-modules --env-file=.env.test node_modules/.bin/jest --runInBand",

    "docker:up": "bash src/scripts/bash/dev.sh up",
    "docker:down": "bash src/scripts/bash/dev.sh down",
    "docker:down:v": "bash src/scripts/bash/dev.sh down -v",
    "docker:logs": "bash src/scripts/bash/dev.sh logs",
    "docker:restart": "bash src/scripts/bash/dev.sh restart",
    "docker:ps": "bash src/scripts/bash/dev.sh ps",
    "docker:migrate": "bash src/scripts/bash/dev.sh migrate",

    "test:docker": "bash src/scripts/bash/test.sh run",
    "test:docker:up": "bash src/scripts/bash/test.sh up",
    "test:docker:down": "bash src/scripts/bash/test.sh down",
    "test:docker:logs": "bash src/scripts/bash/test.sh logs",
    "test:docker:migrate": "bash src/scripts/bash/test.sh migrate",
    "test:docker:watch": "cross-env NODE_ENV=test node --experimental-vm-modules --env-file=.env.test node_modules/.bin/jest --watch --runInBand",

    "prod:up": "bash src/scripts/bash/prod.sh up",
    "prod:down": "bash src/scripts/bash/prod.sh down",
    "prod:down:v": "bash src/scripts/bash/prod.sh down -v",
    "prod:logs": "bash src/scripts/bash/prod.sh logs",
    "prod:ps": "bash src/scripts/bash/prod.sh ps"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kybrakorkmaz/cookie-and-tea-backend.git"
  },
  "keywords": [],
  "author": "Kubra Korkmaz",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/kybrakorkmaz/cookie-and-tea-backend/issues"
  },
  "homepage": "https://github.com/kybrakorkmaz/cookie-and-tea-backend#readme",
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "morgan": "^1.10.1",
    "postgres": "^3.4.9",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.4.0",
    "supertest": "^6.3.3"
  }
}
