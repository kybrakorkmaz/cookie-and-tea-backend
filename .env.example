# ============================================
# Application Settings
# ============================================
NODE_ENV=development
PORT=8000
API_PORT=8003
BASE_URL=http://localhost:8000
JWT_SECRET=your-secret-key-here

# ============================================
# Database Settings (Local Docker)
# ============================================
DATABASE_URL=postgres://postgres:password@localhost:5434/cookie_and_tea
DB_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=cookie_and_tea

# ============================================
# pgAdmin Settings (Development Only)
# ============================================
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@local.com
PGADMIN_DEFAULT_PASSWORD=admin

# ============================================
# Iyzico Payment Configuration
# ============================================
IYZICO_API_KEY=sandbox-your_iyzico_api_key
IYZICO_SECRET_KEY=sandbox-your_iyzico_secret_key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Portfolio demo: "true" simulates 3DS (HMAC-signed callback, no charges).
# Must also be set in the Vercel project env — local .env.production is not uploaded.
MOCK_IYZICO=true

# ============================================
# Cloudinary (Media Upload)
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# Email Configuration (Mailtrap)
# ============================================
# Option A — Sandbox (dev/test, mails never leave Mailtrap):
#   EMAIL_HOST=sandbox.smtp.mailtrap.io
#   EMAIL_PORT=2525
#   EMAIL_USERNAME / EMAIL_PASSWORD = per-inbox credentials from
#   Mailtrap → Email Testing → your inbox → SMTP Settings
#
# Option B — Email Sending (production, real delivery):
#   EMAIL_HOST=live.smtp.mailtrap.io
#   EMAIL_PORT=587
#   EMAIL_USERNAME=api            <- literally the string "api"
#   EMAIL_PASSWORD=<YOUR_API_TOKEN>  <- Mailtrap → Email Sending → SMTP & API Settings
#   FROM_EMAIL must belong to a domain verified under Mailtrap → Sending Domains
#   (trial accounts may send from hello@demomailtrap.co, but only to the
#    email address of the Mailtrap account owner)
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=your_email_username
EMAIL_PASSWORD=your_email_password
FROM_NAME="Your App Name"
FROM_EMAIL=noreply@yourapp.com

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_ORIGIN=http://localhost:5173

# ============================================
# Vercel Cron (production only)
# ============================================
# Protects /api/v1/cron/* endpoints. Vercel sends it as a Bearer token.
# Generate one: https://vercel.com/docs/cron-jobs#securing-cron-jobs
CRON_SECRET=your-random-cron-secret
